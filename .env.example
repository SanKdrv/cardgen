# Скопируйте в .env и заполните. Файл .env в .gitignore.

# Провайдер: openai (любой OpenAI-совместимый API), fixture (офлайн-демо),
# template (только детерминированный шаблон без LLM).
CARDGEN_PROVIDER=openai

# OpenCode Go (наш основной вариант). Для OpenAI: https://api.openai.com/v1
# Для локальной Ollama: http://localhost:11434/v1
CARDGEN_BASE_URL=https://opencode.ai/zen/go/v1
CARDGEN_MODEL=deepseek-v4.1-flash
CARDGEN_API_KEY=

# OpenCode Go требует идентификатор сессии в заголовке. Оставьте пустым
# для OpenAI/DeepSeek/Ollama.
CARDGEN_SESSION_HEADER=x-opencode-session
CARDGEN_SESSION_PREFIX=ses_

CARDGEN_TIMEOUT_S=180
CARDGEN_MAX_ATTEMPTS=2
CARDGEN_TEMPERATURE=0.2
# Reasoning-моделям нужен запас: иначе весь лимит уходит в reasoning_content.
CARDGEN_MAX_OUTPUT_TOKENS=16000
CARDGEN_MAX_CONCURRENCY=4
CARDGEN_CONCURRENCY_TIMEOUT_S=30
CARDGEN_RATE_LIMIT_PER_MINUTE=60
CARDGEN_LOG_LEVEL=INFO
